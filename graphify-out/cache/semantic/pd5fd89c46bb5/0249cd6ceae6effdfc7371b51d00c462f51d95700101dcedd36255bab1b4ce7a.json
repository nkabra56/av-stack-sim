{"nodes": [{"id": "claude_skills_graphify_references_update_hub", "label": "update.md reference doc", "file_type": "document", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_references_update_incremental_flow", "label": "--update incremental re-extraction flow", "file_type": "concept", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_references_update_detect_incremental_function", "label": "graphify.detect.detect_incremental()", "file_type": "concept", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_references_update_build_merge_function", "label": "graphify.build.build_merge()", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads graph.json directly without a NetworkX round-trip so edge direction (calls/implements/imports) is always preserved (#801); every source_file in the new chunk is dropped from the base before merge so replace-on-re-extract reconciles changed files (#1344) without needing to also prune 'changed' files (which would wrongly delete freshly re-extracted content, #1178 moot)."}, {"id": "claude_skills_graphify_references_update_graph_diff_function", "label": "graphify.analyze.graph_diff()", "file_type": "concept", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_references_update_cluster_only_flow", "label": "graphify cluster-only . (self-contained recluster)", "file_type": "concept", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skips Steps 1-3 and re-clusters the existing graph directly; Steps 5-9 must not be re-run afterward because they read intermediate files a prior build's cleanup already deleted, raising FileNotFoundError (#1392)."}, {"id": "claude_skills_graphify_references_update_manifest_stamping", "label": "Manifest stamping (only mark files that actually produced output)", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A changed doc/paper/image whose chunk failed or was omitted must stay unstamped so the next --update re-queues it; otherwise it is marked done and its content is lost forever (#2015). Dispatched-but-not-stamped files also have their stale semantic_hash cleared so detect_incremental doesn't read them as unchanged (#1948)."}], "edges": [{"source": "claude_skills_graphify_references_update_manifest_stamping", "target": "claude_skills_graphify_skill_step9_manifest_cost_cleanup", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_references_update_build_merge_function", "target": "claude_skills_graphify_skill_step4_build_cluster_analyze", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/update.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_references_update_cluster_only_flow", "target": "claude_skills_graphify_skill_fast_path_existing_graph", "relation": "semantically_
{"nodes": [{"id": "claude_skills_graphify_references_extraction_spec_hub", "label": "extraction-spec.md reference doc", "file_type": "document", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_references_extraction_spec_confidence_rubric", "label": "Discrete confidence_score rubric", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed discrete values (0.95/0.85/0.75/0.65/0.55) instead of a continuous range, because production data showed models collapse continuous guidance into a bimodal 0.5/0.85+ split; discrete rubrics are followed more faithfully."}, {"id": "claude_skills_graphify_references_extraction_spec_node_id_format", "label": "Node ID format ({full_path_stem}_{entity})", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses every directory level (not just the immediate parent) so same-named files in different directories don't collide, and must match the AST extractor's ID scheme exactly or it creates orphan ghost-duplicate nodes."}, {"id": "claude_skills_graphify_references_extraction_spec_semantically_similar_edge", "label": "semantically_similar_to edge type", "file_type": "concept", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_references_extraction_spec_hyperedges_concept", "label": "Hyperedges (3+ node group relationships)", "file_type": "concept", "source_file": ".claude/skills/graphify/references/extractio
{"nodes": [{"id": "claude_skills_graphify_references_query_hub", "label": "query.md reference doc", "file_type": "document", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_references_query_vocab_expansion", "label": "Constrained query vocab expansion", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify query matches via case-folded substring + IDF with no stemming/synonyms/cross-language matching, so a wording mismatch between the user's question and the graph's labels collapses the answer to noise; expanding the query against the graph's own extracted vocabulary (never inventing tokens) fixes this before traversal."}, {"id": "claude_skills_graphify_references_query_bfs_traversal", "label": "BFS traversal mode (broad context)", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_references_query_dfs_traversal", "label": "DFS traversal mode (trace a chain)", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_references_query_save_result_command", "label": "graphify save-result (--outcome useful|dead_end|corrected)", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_references_query_work_memory_reflect", "label": "graphify reflect / LESSONS.md (self-improving loop)", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "save-result outcomes (useful/dead_end/corrected) accumulate into LESSONS.md listing preferred sources, known dead ends, and corrections, so later sessions reuse what worked instead of re-deriving it; --if-stale keeps refresh cost near zero when the commit hook already regenerated it."}, {"id": "claude_skills_graphify_references_query_path_command", "label": "/graphify path (shortest path between concepts)", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_references_query_explain_command", "label": "/graphify explain (plain-language node explanation)", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_skills_graphify_references_query_hub", "target": "claude_skills_graphify_references_query_vocab_expansion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_references_query_hub", "target": "claude_skills_graphify_references_query_bfs_traversal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_references_query_hub", "target": "claude_skills_graphify_references_query_dfs_traversal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify
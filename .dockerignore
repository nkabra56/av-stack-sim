# Mirrors .gitignore, plus build-context-only exclusions .gitignore has no reason to
# carry (the .git history itself, IDE/OS junk that never gets committed anyway).
.git
.github

__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
build/
dist/

*.gif
*.png

.venv/
venv/
env/

.vscode/
.idea/
.DS_Store
Thumbs.db
